<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.lawinomeet</groupId>
    <artifactId>lawino-meet-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Lawino Meet - Microservices Platform</name>
    <description>Root Aggregator for Lawino Meet Spring Boot Microservices</description>

    <modules>
        <module>services/auth-service</module>
        <module>services/user-service</module>
        <module>services/appointment-service</module>
        <module>services/meeting-service</module>
        <module>services/notification-service</module>
        <module>services/chat-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <spring.boot.version>3.3.5</spring.boot.version>
        <jjwt.version>0.12.6</jjwt.version>
        <mysql.version>8.3.0</mysql.version>
    </properties>
</project>
