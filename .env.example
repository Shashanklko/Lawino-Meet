APPOINTMENT_SERVICE_URL=http://localhost:8083
MEETING_SERVICE_URL=http://localhost:8084
NOTIFICATION_SERVICE_URL=http://localhost:8085
CHAT_SERVICE_URL=http://localhost:8086

# Frontend & Gateway URLs
