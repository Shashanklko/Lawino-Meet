# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_USER=lawino_user
MYSQL_PASSWORD=lawino_password

# Service Specific Database Names
