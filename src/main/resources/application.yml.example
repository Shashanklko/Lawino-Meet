server:
  port: 8080

spring:
  application:
    name: LawinoMeet-Backend

  # Smart Fallback Database Configuration
  # If DB_URL environment variable is provided, connects to Cloud MySQL.
  # If DB_URL is omitted, automatically falls back to instant In-Memory H2 MySQL Mode (Zero Setup).
  datasource:
    url: ${DB_URL:jdbc:h2:mem:lawinomeetdb;DB_CLOSE_DELAY=-1;MODE=MySQL}
    username: ${DB_USERNAME:sa}
    password: ${DB_PASSWORD:}
    driver-class-name: ${DB_DRIVER:org.h2.Driver}

  # JPA / Hibernate Configurations
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        format_sql: true

  # MongoDB Configuration
  data:
    mongodb:
      uri: ${MONGO_URI:mongodb://localhost:27017/lawinomeet}
      database: ${MONGO_DATABASE:lawinomeet}

# Custom JWT Application Properties
jwt:
  secret: ${JWT_SECRET:lawinomeet_super_secret_jwt_key_256_bits_length_for_testing_purposes_123456}
  expirationMs: 86400000 # 24 hours

# Frontend Origin Configuration
app:
  cors:
    allowed-origins: ${ALLOWED_ORIGINS:*}
  frontend:
    url: ${FRONTEND_URL:http://localhost:5173}
  seed-data:
    enabled: ${SEED_DATA_ENABLED:true}

