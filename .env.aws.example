# =========================================================================
# LawinoMeet - AWS Production Docker Swarm Environment Configuration Template
# Copy this file to .env.aws on your Swarm Manager instance before deploying:
#   cp .env.aws.example .env.aws
#
# IMPORTANT: Never commit .env.aws with real production secrets to Git!
# =========================================================================

# -------------------------------------------------------------------------
# 1. Docker Registry & Image Configuration (Docker Hub)
# -------------------------------------------------------------------------
DOCKER_HUB_USERNAME=lawinomeet
IMAGE_TAG=latest

# -------------------------------------------------------------------------
# 2. Database Mode Selection
#    Options:
#      - 'rds'   : Production AWS RDS MySQL (Recommended, managed backups)
#      - 'mysql' : Self-hosted single MySQL 8 container in Swarm overlay
# -------------------------------------------------------------------------
DB_MODE=rds

# -------------------------------------------------------------------------
# 3. Database Credentials & Connectivity
#    For Mode B (RDS):
#      Set MYSQL_HOST to your RDS Endpoint (e.g. lawino-mysql.cz8xxxx.rds.amazonaws.com)
#    For Mode A (Docker MySQL container):
#      Set MYSQL_HOST=mysql
# -------------------------------------------------------------------------
MYSQL_HOST=lawino-mysql.cz8xxxx.rds.amazonaws.com
MYSQL_PORT=3306
MYSQL_USER=lawino_admin
MYSQL_PASSWORD=replace-with-strong-rds-password
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password

# Logical Microservice Database Names
AUTH_DB_NAME=auth_db
USER_DB_NAME=user_db
APPOINTMENT_DB_NAME=appointment_db
MEETING_DB_NAME=meeting_db
NOTIFICATION_DB_NAME=notification_db
CHAT_DB_NAME=chat_db

# -------------------------------------------------------------------------
# 4. JWT Authentication & Security
# -------------------------------------------------------------------------
JWT_SECRET=generate-a-cryptographically-secure-256-bit-minimum-secret-key-for-prod
JWT_EXPIRATION_MS=43200000
JWT_ISSUER=lawino-meet

# -------------------------------------------------------------------------
# 5. Distributed RabbitMQ Message Broker Credentials
# -------------------------------------------------------------------------
RABBITMQ_USER=lawino_prod_mq
RABBITMQ_PASSWORD=replace-with-strong-rabbitmq-secret

# -------------------------------------------------------------------------
# 6. AWS S3 Storage & Region Configuration
#    EC2 Instance Profile (IAM Role) is used by default; static keys optional.
# -------------------------------------------------------------------------
S3_BUCKET_NAME=lawinomeet-assests
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# -------------------------------------------------------------------------
# 7. CloudWatch Centralized Logging
# -------------------------------------------------------------------------
CLOUDWATCH_LOG_GROUP=/lawinomeet/application
CLOUDWATCH_RETENTION_DAYS=7

# -------------------------------------------------------------------------
# 8. WebRTC STUN/TURN Signaling for Meeting Service
# -------------------------------------------------------------------------
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# -------------------------------------------------------------------------
# 9. Java Virtual Machine Heap Optimization (per t3.large 8GB instance)
# -------------------------------------------------------------------------
JAVA_OPTS=-Xms256m -Xmx400m -XX:+UseG1GC
